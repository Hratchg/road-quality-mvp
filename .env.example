# .env.example — environment variable template for road-quality-mvp
#
# Copy this file to .env and fill in any values you want to override.
# .env is git-ignored; .env.example is committed.
#
# Variables listed here match what the codebase currently reads (backend, frontend, scripts).
# Future M1 phases will extend this file as new env vars are introduced.

# ----- Database -----
# Consumed by: backend/app/db.py, scripts/seed_data.py, scripts/compute_scores.py, scripts/ingest_iri.py
# The dev default below matches docker-compose.yml. Replace with your cloud DB URL in production (Phase 5).
DATABASE_URL=postgresql://rq:rqpass@localhost:5432/roadquality

# ----- Frontend -> Backend API -----
# Consumed by: frontend/src/api.ts (import.meta.env.VITE_API_URL)
# In local Vite dev, the dev-server proxies /api to the backend — leave blank or set to an absolute URL.
# In Docker Compose, docker-compose.yml sets this to http://localhost:8000.
# In production (Phase 5), set this to the deployed backend origin.
VITE_API_URL=http://localhost:8000

# ----- Mapbox (optional, Phase 5+ frontend tile upgrade) -----
# Consumed by: frontend (not yet wired; currently declared empty in docker-compose.yml)
# Leave blank to use the default Leaflet+OSM tiles. Set to a real Mapbox token to enable premium tiles.
# NEVER commit a real token to git — this template stays empty.
VITE_MAPBOX_TOKEN=

# ----- YOLOv8 Detector Model -----
# Consumed by: data_pipeline/detector_factory.py
# Either an HF repo id ("user/repo" or "user/repo:filename.pt" or "user/repo@revision")
# OR a local .pt file path ("./models/my.pt" or "/abs/path.pt").
# If unset, the factory uses the default HF repo baked into detector_factory.py
# (currently: keremberke/yolov8s-pothole-segmentation).
# Pin to a specific @revision in production to avoid silent weight swaps (see Pitfall 8
# in .planning/phases/02-real-data-detector-accuracy/02-RESEARCH.md).
YOLO_MODEL_PATH=

# ----- HuggingFace Hub (fine-tune upload only) -----
# Consumed by: scripts/finetune_detector.py (--push flag)
# Create a write-scope token at https://huggingface.co/settings/tokens.
# NEVER commit a real token. Leave empty if you will not be publishing fine-tunes.
HUGGINGFACE_TOKEN=

# ----- Mapillary API (eval-set + Phase 3 ingestion) -----
# Consumed by: data_pipeline/mapillary.py, scripts/fetch_eval_data.py,
# scripts/ingest_mapillary.py (Phase 3).
# Create a free token at https://www.mapillary.com/dashboard/developers.
# Required for --build mode of fetch_eval_data.py; not needed once the
# labelled dataset is cached under data/eval_la/ (the SHA256 manifest
# allows --verify-only reads without any API call).
# Mapillary imagery is licensed CC-BY-SA 4.0 -- downstream redistribution
# must preserve per-image attribution (see data/eval_la/manifest.json).
MAPILLARY_ACCESS_TOKEN=

# ----- Auth (Phase 4, REQ-user-auth) -----
# Consumed by: backend/app/auth/tokens.py (read at call time; fail-fast on
# empty in non-test mode; fail-fast on < 32 chars).
# HMAC signing key for HS256 JWT tokens (04-CONTEXT.md D-01).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MUST be at least 32 chars. Production (Phase 5) sources this from the cloud
# host's secret store, NOT from .env.
# Rotating this key invalidates ALL active sessions — emergency revocation
# lever (04-CONTEXT.md D-01 + RESEARCH Pitfall 9).
# NEVER commit a real key — this template stays empty.
AUTH_SIGNING_KEY=

# ----- CORS (Phase 5, REQ-prod-deploy SC #2) -----
# Consumed by: backend/app/main.py (read at module import; default fallthrough
# to http://localhost:3000 if unset so docker-compose dev startup works).
# Comma-separated list of frontend origins allowed to make CORS requests.
# Production (Phase 5+) sets this via 'fly secrets set' to the deployed
# frontend's *.fly.dev URL (e.g., https://road-quality-frontend.fly.dev).
# Local dev: leave blank or unset — main.py falls through to localhost:3000.
# Future: add a custom domain by appending a comma-separated value, no code change.
# NEVER use '*' in production — defeats the entire SC #2 contract.
ALLOWED_ORIGINS=

# ----- LA City Socrata API (Phase 9 crash ingest, optional) -----
# Consumed by: data_pipeline/lacity_socrata.py, scripts/ingest_crashes.py
# Get a token at https://data.lacity.org/profile/edit/developer_settings
# (free, registers an "app" — 1000 req/hr per token).
# OPTIONAL: anonymous Socrata fetch works at a lower shared-IP rate limit;
# the token is recommended for production runs and required for the
# Phase 12 quarterly operator-driven re-pull.
# Memory pin: load via the project's Python .env parser, NOT `source .env`
# (Socrata tokens may contain pipes that the shell would interpret).
LACITY_APP_TOKEN=

# ----- LA City snap-match radius override (Phase 9, optional) -----
# Consumed by: scripts/ingest_crashes.py (default 50.0 meters per D-09-03)
# Tighten to ~25m for higher-precision intersections; widen to ~100m if
# the operator runbook check (run-summary dropped_outside_snap > 5%) fires.
LACITY_SNAP_M=50.0

# ----- Routing perf tunables (Phase 8 carryforward → REQ-route-filter-env-vars-doc) -----
# Consumed by: backend/app/routes/routing.py:22-23
# Spatial buffer in degrees around the route bbox for the segment_scores filter
# (default 0.03 ≈ 3.3 km). Wider buffer covers more candidate detours; narrower
# keeps the temp-table small (Phase 8 perf budget).
# Tuning rationale: see .planning/milestones/v0.3.0-phases/08-routing-performance/08-PERF-NUMBERS.md
ROUTE_FILTER_BUFFER_DEG=0.03

# Multiplier for the wide-fallback buffer when the initial filter returns 0
# candidates (default 2.0 → 6.6 km). 3-attempt fallback chain: filter → wide → full.
# Tune up for sparse-corner routes; tune down for tight perf.
# Tuning rationale: see .planning/milestones/v0.3.0-phases/08-routing-performance/08-PERF-NUMBERS.md
ROUTE_FILTER_WIDEN_FACTOR=2.0
